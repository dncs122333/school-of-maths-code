# API server. Cloudflare sits in front; Caddy gets its own certificate and handles HTTPS to Cloudflare.
{
	servers {
		# Only addresses in Cloudflare's published ranges may say who the client is (https://www.cloudflare.com/ips/).
		# Anyone connecting directly can't fake an address to get around the login limits.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$API_DOMAIN} {
	# Compresses JSON and text only; PDFs and images are already compressed
	encode zstd gzip

	# Uploads are capped at 25 MB by the app; stop anything far larger here
	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy backend:8001 {
		header_up X-Forwarded-For {client_ip}
	}
}
