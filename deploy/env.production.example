# Copied to /opt/som/.env by server-setup.sh. Fill in every value. Never commit the filled-in copy.
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=som_prod
# Make one with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=https://app.example.com
APP_URL=https://app.example.com
ADMIN_EMAIL=
# One-time: creates the admin on first start. At least 12 characters, or it's ignored. Remove this line afterwards.
ADMIN_PASSWORD=
APP_TIMEZONE=Asia/Kolkata
ENABLE_WATERMARKING=true

# Cloudflare R2
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=som-files
S3_BACKUP_BUCKET=som-backups
S3_REGION=auto

# Brevo: password-reset emails. EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=

# Sentry: error reports. Leave empty to turn off.
SENTRY_DSN=
